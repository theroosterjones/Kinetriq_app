// Copy this file to Config/KinetriqSecrets.xcconfig and replace the placeholder
// values locally. Do not commit the real Config/KinetriqSecrets.xcconfig file.

KINETRIQ_REVENUECAT_API_KEY = REVENUECAT_IOS_PUBLIC_SDK_KEY_HERE
KINETRIQ_SUPABASE_URL = SUPABASE_PROJECT_URL_HERE
KINETRIQ_SUPABASE_ANON_KEY = SUPABASE_ANON_KEY_HERE
KINETRIQ_PRIVACY_POLICY_URL = https:/$()/www.kinetriq.com/privacy
KINETRIQ_TERMS_URL = https:/$()/www.kinetriq.com/terms
